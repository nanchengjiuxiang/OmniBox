<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      OmniBox 的核心承诺：零网络权限。
      任何传递依赖（ML Kit / Firebase 系）在 Manifest 合并阶段注入的 INTERNET 在此显式移除。
      发布前还需检查 app/build/intermediates/merged_manifests/release/AndroidManifest.xml。
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- 运行时权限：全部为「按需申请 + 拒绝即降级」，任意一项被拒都不影响其他工具 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 倒计时到点提醒；无此权限时降级为仅页内倒计时，不做假提醒 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 重启后重建倒计时提醒（AlarmManager 的闹钟不跨重启存活） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 硬件特性全部声明为可选：缺失传感器的设备需走设计稿中的降级页 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <application
        android:name=".OmniBoxApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.OmniBox">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OmniBox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 深链 omnibox://tool/{tool_id}，供小组件与快捷方式直达 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="omnibox" android:host="tool" />
            </intent-filter>
        </activity>

        <!-- 倒计时到点提醒。exported=false：仅本应用的显式 PendingIntent 能触发 -->
        <receiver
            android:name="com.omnibox.feature.countdown.CountdownReminderReceiver"
            android:exported="false" />

        <!--
          开机 / 应用更新后重建提醒。exported=false 仍能收到系统广播：
          BOOT_COMPLETED 与 MY_PACKAGE_REPLACED 由系统以特权身份派发，不受 exported 限制。
        -->
        <receiver
            android:name="com.omnibox.feature.countdown.CountdownBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          桌面小组件（Glance）。exported=false：APPWIDGET_UPDATE 由系统派发，不需要对外暴露；
          小组件内容全部来自本机 Room，点击走 omnibox://tool/{id} 深链回到 App。
        -->
        <receiver
            android:name=".widget.CountdownWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_countdown_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.QrWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_qr_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/qr_widget_info" />
        </receiver>

        <!-- 15 分钟一次的小组件自刷新，用不精确闹钟，不需要精确闹钟权限 -->
        <receiver
            android:name=".widget.CountdownWidgetTickReceiver"
            android:exported="false" />

        <!-- 数据变更即刷新：app 内广播，exported=false 只接受本应用发送 -->
        <receiver
            android:name=".widget.CountdownWidgetRefreshReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.omnibox.action.COUNTDOWN_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
